{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Next Launcher",
  "mainBinaryName": "next-launcher",
  "version": "0.1.5",
  "identifier": "app.nextlauncher.client",
  "build": {
    "beforeDevCommand": "npm --prefix ui run dev",
    "devUrl": "http://localhost:5174",
    "beforeBuildCommand": "npm --prefix ui run build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: http://img.localhost img: https://cdn1.epicgames.com https://cdn2.unrealengine.com",
        "font-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost"
      },
      "freezePrototype": false
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "compression": "lzma"
      }
    },
    "resources": {
      "THIRD-PARTY-NOTICES.txt": "THIRD-PARTY-NOTICES.txt",
      "../LICENSE": "LICENSE.txt"
    },
    "license": "GPL-3.0-or-later"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZCRjZEQTU1OUYxMDNBRkYKUldUL09oQ2ZWZHIyK3lqRjVuazloQlJuODdXUmFKc3MzU0pCMm1Jei9HKzZnNXZDOWQ1d0MzUnQK",
      "endpoints": [
        "https://github.com/ItsHezy/next-launcher/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
